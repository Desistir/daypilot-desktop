{
  "name": "daypilot-desktop",
  "version": "0.3.1",
  "description": "Local-first personal planner",
  "author": "DayPilot",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "portable": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.daypilot.desktop",
    "productName": "DayPilot",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": true,
      "signExecutable": false
    }
  },
  "license": "MIT"
}
